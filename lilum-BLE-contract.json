{
  "documentType": "lilum-ble-contract",
  "formatVersion": 1,
  "documentRevision": 1,
  "interpreter": {
    "fieldTypes": {
      "u8": "unsigned 8-bit integer",
      "u16": "unsigned 16-bit integer, little-endian",
      "u32": "unsigned 32-bit integer, little-endian",
      "u64": "unsigned 64-bit integer, little-endian",
      "bytes": "opaque byte string; length is a number, 'remaining', or lengthFrom (the value of an earlier u8/u16 field in the same body)",
      "array": "count repetitions of the element field list"
    },
    "notes": "A body is the ordered concatenation of its fields with no padding. Unknown protocol major versions, unknown field types and unknown opcodes must be rejected, never interpreted as another version. Published protocol entries are immutable, so an entry carries no mutable status: the newest protocol is the one with the highest major then minor version, and the app selects the entry that matches the version the device reports."
  },
  "protocols": [
    {
      "protocol": { "major": 1, "minor": 0 },
      "publishedDate": "2026-10-03",
      "changeNotes": "Initial protocol definition. Corresponds to app-element-contract sections 10.9 to 10.16 and 11. Not related to the retired legacy BLE interface.",
      "definition": {
        "byteOrder": "little-endian",
        "connectionPolicy": {
          "authentication": "none",
          "windowSeconds": 120,
          "maxConnectionsPerPhysicalPowerOn": 1,
          "softwareResetGrantsWindow": false,
          "automaticReconnect": false
        },
        "service": {
          "uuid": "a8e70000-51b3-4ef4-b893-5be217d5a2c0",
          "characteristics": [
            {
              "name": "deviceInformation",
              "uuid": "a8e70001-51b3-4ef4-b893-5be217d5a2c0",
              "properties": ["read"],
              "supportsReadBlob": true
            },
            {
              "name": "commands",
              "uuid": "a8e70002-51b3-4ef4-b893-5be217d5a2c0",
              "properties": ["writeWithResponse"]
            },
            {
              "name": "snapshotUpload",
              "uuid": "a8e70003-51b3-4ef4-b893-5be217d5a2c0",
              "properties": ["writeWithResponse"]
            },
            {
              "name": "replies",
              "uuid": "a8e70004-51b3-4ef4-b893-5be217d5a2c0",
              "properties": ["indicate"],
              "hasClientCharacteristicConfiguration": true
            }
          ],
          "requirements": [
            "Write Without Response, ATT long writes and a larger MTU are not required.",
            "Subscribe to reply indications before opening a session.",
            "ATT write responses and indication confirmations acknowledge transport only, never durable storage."
          ]
        },
        "advertising": {
          "primary": ["flags", "completeServiceUuid128"],
          "scanResponse": ["serviceData128(serviceUuid + productCode u16)", "completeLocalName(optional, informative)"],
          "serviceDataFields": [{ "name": "productCode", "type": "u16" }],
          "localNameIsIdentity": false,
          "notes": "Identify elements by service UUID and product code, never by local name. Full identity and compatibility come only from connected readback."
        },
        "deviceInformation": {
          "immutablePerBoot": true,
          "supportedInfoFormats": [1],
          "fields": [
            { "name": "infoFormat", "type": "u8", "constant": 1 },
            { "name": "protocolMajor", "type": "u8" },
            { "name": "protocolMinor", "type": "u8" },
            { "name": "productCode", "type": "u16" },
            { "name": "hardwareRevision", "type": "u16" },
            { "name": "firmwareMajor", "type": "u8" },
            { "name": "firmwareMinor", "type": "u8" },
            { "name": "firmwarePatch", "type": "u16" },
            { "name": "definitionRevision", "type": "u32" },
            { "name": "capabilities", "type": "u32" },
            { "name": "maxMessage", "type": "u16", "constant": 512 },
            { "name": "maxFrame", "type": "u16", "constant": 244 },
            { "name": "deviceIdLength", "type": "u8", "minimum": 1, "maximum": 32 },
            { "name": "deviceId", "type": "bytes", "lengthFrom": "deviceIdLength" }
          ],
          "capabilityBits": [
            { "bit": 0, "name": "musicHardware", "note": "hardware support only; setting visibility also depends on the animations" },
            { "bit": 1, "name": "movementHardware", "note": "hardware support only; setting visibility also depends on the animations" }
          ],
          "unknownCapabilityBitsMustBeZero": true
        },
        "framing": {
          "header": [
            { "name": "messageId", "type": "u32" },
            { "name": "offset", "type": "u16" },
            { "name": "totalLength", "type": "u16" }
          ],
          "maxFrameValueBytes": 244,
          "frameValueBytesFormula": "min(attMtu - 3, 244)",
          "maxLogicalMessageBytes": 512,
          "rules": [
            "totalLength counts logical-message bytes only; offsets start at zero and advance by accepted data bytes.",
            "No frame has zero data bytes or bytes beyond its declared message.",
            "The app allocates strictly increasing nonzero message IDs across both writable characteristics; replies echo the request message ID; IDs never wrap.",
            "One reassembly buffer per writable characteristic; messages on one characteristic cannot interleave; the two characteristics may interleave.",
            "Reject gaps, overflow, changed totals and different bytes at an already received offset; an identical duplicate fragment is harmless.",
            "A command-level retry uses a new message ID and the same transaction ID and content.",
            "At most four complete reply messages may be pending; reserve space before accepting an operation.",
            "Replies may complete out of request order; correlate by message ID."
          ]
        },
        "messages": {
          "requestHeader": [
            { "name": "opcode", "type": "u8" },
            { "name": "sessionId", "type": "bytes", "length": 16 }
          ],
          "openSessionIdMustBeZero": true,
          "replyHeader": [
            { "name": "opcode", "type": "u8", "rule": "request opcode OR 0x80" },
            { "name": "status", "type": "u8", "enum": "status" },
            { "name": "sessionId", "type": "bytes", "length": 16 },
            { "name": "detail", "type": "u16" }
          ],
          "detailNoneValue": 65535
        },
        "structures": {
          "liveVersion": [
            { "name": "generation", "type": "u32" },
            { "name": "sequence", "type": "u32" }
          ],
          "liveVersionVector": [
            {
              "name": "versions",
              "type": "array",
              "count": 5,
              "element": [
                { "name": "generation", "type": "u32" },
                { "name": "sequence", "type": "u32" }
              ],
              "streamOrder": ["startupBrightness", "flashlightHue", "flashlightSaturation", "flashlightBrightness", "animationEntry"],
              "unusedPairsAreAllZero": true
            }
          ],
          "transactionReceipt": [
            { "name": "transactionId", "type": "u32" },
            { "name": "state", "type": "u8", "enum": "transactionState" },
            { "name": "outcome", "type": "u8", "enum": "status" },
            { "name": "revision", "type": "bytes", "length": 24 },
            { "name": "hash", "type": "bytes", "length": 32 }
          ],
          "receiptRules": [
            "revision and hash are zero unless state is SUCCEEDED, in which case they describe the original success.",
            "Receipts are included for syntactically valid transaction requests even when the request is rejected; unknown IDs report state NONE with zero metadata.",
            "Header status reports the handling of the request; the receipt outcome reports the transaction itself."
          ]
        },
        "commands": [
          {
            "opcode": 1,
            "name": "OPEN",
            "characteristic": "commands",
            "request": [
              { "name": "requestedMajor", "type": "u8" },
              { "name": "requestedMinor", "type": "u8" },
              { "name": "clientNonce", "type": "bytes", "length": 16 }
            ],
            "reply": [
              { "name": "selectedMajor", "type": "u8" },
              { "name": "selectedMinor", "type": "u8" },
              { "name": "clientNonce", "type": "bytes", "length": 16 }
            ],
            "notes": "Establishes exactly one session per connection; the new session ID is in the reply header (nonzero, from a cryptographic random generator). Protocol 1.0 selects exactly 1.0. An identical retry returns the same session; a different OPEN is rejected until disconnect. OPEN is not pairing."
          },
          {
            "opcode": 2,
            "name": "READ_SNAPSHOT",
            "characteristic": "commands",
            "request": [],
            "reply": [
              { "name": "revision", "type": "bytes", "length": 24 },
              { "name": "hash", "type": "bytes", "length": 32 },
              { "name": "snapshotLength", "type": "u16" },
              { "name": "snapshot", "type": "bytes", "lengthFrom": "snapshotLength" }
            ],
            "notes": "Captures the saved snapshot, revision and hash together; the request message ID identifies the frozen read, retained at most 30 seconds. BUSY while a read is retained or a commit is COMMITTING."
          },
          {
            "opcode": 3,
            "name": "ACCEPT_READ",
            "characteristic": "commands",
            "request": [
              { "name": "readMessageId", "type": "u32" },
              { "name": "revision", "type": "bytes", "length": 24 },
              { "name": "hash", "type": "bytes", "length": 32 }
            ],
            "reply": [],
            "notes": "Valid only after the app has validated every byte of the read. Releases the frozen buffer and opens the session write/live gate."
          },
          {
            "opcode": 4,
            "name": "RELEASE_READ",
            "characteristic": "commands",
            "request": [{ "name": "readMessageId", "type": "u32" }],
            "reply": [],
            "notes": "Frees the frozen read without opening the gate."
          },
          {
            "opcode": 16,
            "name": "BEGIN",
            "characteristic": "commands",
            "request": [
              { "name": "transactionId", "type": "u32" },
              { "name": "kind", "type": "u8", "enum": "beginKind" },
              { "name": "primarySetting", "type": "u8", "note": "zero-based setting index for automatic saves; 255 for explicit Apply" },
              { "name": "directLiveMask", "type": "u8", "reservedBitsMustBeZero": "bits 4..7" },
              { "name": "expectedRevision", "type": "bytes", "length": 24 },
              { "name": "snapshotLength", "type": "u16" },
              { "name": "snapshotHash", "type": "bytes", "length": 32 },
              { "name": "liveVersions", "structure": "liveVersionVector" }
            ],
            "replyStructure": "transactionReceipt",
            "notes": "Creates a RECEIVING transaction; performs no persistence. Direct-live mask bits 0..3 are startupBrightness, flashlightHue, flashlightSaturation, flashlightBrightness. A dependent startup clamp does not set bit 0."
          },
          {
            "opcode": 17,
            "name": "UPLOAD",
            "characteristic": "snapshotUpload",
            "request": [
              { "name": "transactionId", "type": "u32" },
              { "name": "snapshot", "type": "bytes", "length": "remaining" }
            ],
            "replyStructure": "transactionReceipt",
            "notes": "Exact canonical snapshot bytes. Snapshot Upload characteristic only; a complete valid upload moves the transaction to STAGED."
          },
          {
            "opcode": 18,
            "name": "COMMIT",
            "characteristic": "commands",
            "request": [{ "name": "transactionId", "type": "u32" }],
            "replyStructure": "transactionReceipt",
            "notes": "Replies with the terminal outcome after durable storage and runtime publication."
          },
          {
            "opcode": 19,
            "name": "CANCEL",
            "characteristic": "commands",
            "request": [{ "name": "transactionId", "type": "u32" }],
            "replyStructure": "transactionReceipt",
            "notes": "Wins only before STAGED changes to COMMITTING; afterwards the status is TOO_LATE."
          },
          {
            "opcode": 20,
            "name": "GET_TRANSACTION",
            "characteristic": "commands",
            "request": [{ "name": "transactionId", "type": "u32" }],
            "replyStructure": "transactionReceipt",
            "notes": "Lookup of the active or one of the eight most recent terminal transactions."
          },
          {
            "opcode": 21,
            "name": "GET_STATE",
            "characteristic": "commands",
            "request": [],
            "reply": [
              { "name": "transactionHighWaterMark", "type": "u32" },
              { "name": "activeTransactionId", "type": "u32" },
              { "name": "activeState", "type": "u8", "enum": "transactionState" },
              { "name": "readGate", "type": "u8", "enum": "readGate" },
              { "name": "storageState", "type": "u8", "enum": "storageState" },
              { "name": "revision", "type": "bytes", "length": 24 },
              { "name": "hash", "type": "bytes", "length": 32 }
            ],
            "notes": "A summary only; it never replaces full validated readback."
          },
          {
            "opcode": 32,
            "name": "LIVE_OPEN",
            "characteristic": "commands",
            "request": [
              { "name": "generation", "type": "u32" },
              { "name": "kind", "type": "u8", "enum": "liveKind" }
            ],
            "reply": [{ "name": "generation", "type": "u32" }],
            "notes": "Only an acknowledged LIVE_OPEN creates a lease. Generations are strictly increasing and nonzero."
          },
          {
            "opcode": 33,
            "name": "LIVE_VALUE",
            "characteristic": "commands",
            "request": [
              { "name": "generation", "type": "u32" },
              { "name": "stream", "type": "u8", "enum": "liveStream" },
              { "name": "sequence", "type": "u32" },
              {
                "name": "value",
                "type": "bytes",
                "length": "remaining",
                "lengthByField": { "field": "stream", "map": { "0": 1, "1": 1, "2": 1, "3": 1, "4": 9 } }
              }
            ],
            "reply": [
              { "name": "generation", "type": "u32" },
              { "name": "stream", "type": "u8" },
              { "name": "sequence", "type": "u32" }
            ],
            "notes": "Streams 0..3 carry one byte; stream 4 carries animation ID plus eight parameter bytes. Samples are volatile and never change the saved configuration."
          },
          {
            "opcode": 34,
            "name": "LIVE_HEARTBEAT",
            "characteristic": "commands",
            "request": [{ "name": "generation", "type": "u32" }],
            "reply": [{ "name": "generation", "type": "u32" }],
            "notes": "Not a sample; it does not alter output."
          },
          {
            "opcode": 35,
            "name": "LIVE_STOP",
            "characteristic": "commands",
            "request": [{ "name": "generation", "type": "u32" }],
            "reply": [{ "name": "generation", "type": "u32" }],
            "notes": "Stopping an already closed generation succeeds without affecting a newer one."
          },
          {
            "opcode": 36,
            "name": "LIVE_DROP",
            "characteristic": "commands",
            "request": [
              { "name": "streamMask", "type": "u8" },
              { "name": "liveVersions", "structure": "liveVersionVector" }
            ],
            "replyEchoesRequestBody": true,
            "notes": "Retires only the selected captured versions that are still current."
          }
        ],
        "enums": {
          "status": [
            { "value": 0, "name": "OK" },
            { "value": 1, "name": "IN_PROGRESS" },
            { "value": 2, "name": "NO_CHANGE", "note": "successful automatic no-op" },
            { "value": 3, "name": "INVALID_DATA", "recovery": "correct the request; never retry unchanged data" },
            { "value": 4, "name": "INCOMPATIBLE_IDENTITY_OR_DEFINITION", "recovery": "resolve the target or definition mismatch; never bypass binding checks" },
            { "value": 5, "name": "STALE_REVISION", "recovery": "read back, reconcile the draft, then use a new transaction" },
            { "value": 6, "name": "BUSY", "automaticRetry": true },
            { "value": 7, "name": "STORAGE_FAILURE", "note": "known not committed; not automatically retryable" },
            { "value": 8, "name": "WRONG_SESSION" },
            { "value": 9, "name": "INVALID_STATE" },
            { "value": 10, "name": "ID_REUSE" },
            { "value": 11, "name": "RESULT_EXPIRED" },
            { "value": 12, "name": "CANCELLED" },
            { "value": 13, "name": "STAGING_EXPIRED" },
            { "value": 14, "name": "TOO_LATE" },
            { "value": 15, "name": "HASH_MISMATCH" },
            { "value": 16, "name": "SIZE_LIMIT" },
            { "value": 17, "name": "REVISION_EXHAUSTED" },
            { "value": 18, "name": "READ_REQUIRED" },
            { "value": 19, "name": "NOT_FOUND" },
            { "value": 20, "name": "UNSUPPORTED_COMMAND_OR_VERSION" },
            { "value": 21, "name": "STALE_LIVE_VERSION" },
            { "value": 22, "name": "STORAGE_RECOVERY_REQUIRED" },
            { "value": 23, "name": "TRANSFER_EXPIRED" },
            { "value": 24, "name": "INTERNAL_FAILURE", "note": "includes unavailable secure session-ID generation" }
          ],
          "unknownStatusHandling": "Treat unknown status codes as failures; never as success or as implicit retry permission.",
          "transactionState": [
            { "value": 0, "name": "NONE" },
            { "value": 1, "name": "RECEIVING" },
            { "value": 2, "name": "STAGED" },
            { "value": 3, "name": "COMMITTING" },
            { "value": 4, "name": "SUCCEEDED" },
            { "value": 5, "name": "REJECTED" },
            { "value": 6, "name": "CANCELLED" },
            { "value": 7, "name": "EXPIRED" }
          ],
          "beginKind": [
            { "value": 0, "name": "AUTOMATIC_SAVE" },
            { "value": 1, "name": "EXPLICIT_APPLY" }
          ],
          "readGate": [
            { "value": 0, "name": "CLOSED" },
            { "value": 1, "name": "OPEN" }
          ],
          "storageState": [
            { "value": 0, "name": "READY" },
            { "value": 1, "name": "MAINTENANCE" },
            { "value": 2, "name": "RECOVERY_REQUIRED" }
          ],
          "liveKind": [
            { "value": 0, "name": "NORMAL_BRIGHTNESS", "permittedStreams": [0] },
            { "value": 1, "name": "ANIMATION", "permittedStreams": [0, 4] },
            { "value": 2, "name": "FLASHLIGHT", "permittedStreams": [1, 2, 3] }
          ],
          "liveStream": [
            { "value": 0, "name": "startupBrightness", "valueLength": 1 },
            { "value": 1, "name": "flashlightHue", "valueLength": 1 },
            { "value": 2, "name": "flashlightSaturation", "valueLength": 1 },
            { "value": 3, "name": "flashlightBrightness", "valueLength": 1 },
            { "value": 4, "name": "animationEntry", "valueLength": 9 }
          ]
        },
        "detailEncoding": {
          "none": 65535,
          "setting": { "minimum": 0, "maximum": 12, "meaning": "zero-based setting index" },
          "playlistEntryField": {
            "formula": "base OR (entryIndex << 4) OR field",
            "automaticBase": 4096,
            "manualBase": 8192,
            "entryIndexBase": "zero",
            "fields": "0 = animation ID, 1..8 = parameter slots 0..7"
          },
          "singleSlotField": { "formula": "12288 OR field" },
          "count": { "automatic": 16384, "manual": 16385 },
          "envelopeFailures": "use the status plus the none value; never expose a raw memory offset",
          "rules": [
            "A product or definition mismatch reports INCOMPATIBLE_IDENTITY_OR_DEFINITION with no field.",
            "A brightness-ordering violation reports the minimum (setting 1) when the minimum exceeds the maximum, otherwise the startup brightness (setting 0).",
            "When fields are invalid in more than one place, the first in canonical order is reported.",
            "An automatic save outside its single permitted change reports the first field, in canonical order, that differs from that permitted result.",
            "A recorded rejection returns the same detail whenever its receipt is returned again."
          ]
        },
        "canonicalSnapshot": {
          "minimumBytes": 49,
          "maximumBytes": 301,
          "fields": [
            { "name": "configurationFormat", "type": "u8", "constant": 1 },
            { "name": "productCode", "type": "u16" },
            { "name": "definitionRevision", "type": "u32" },
            { "name": "settings", "type": "bytes", "length": 13, "order": ["startupBrightness", "minimumBrightness", "maximumBrightness", "startupMode", "musicEnabled", "movementEnabled", "singlePressAction", "doublePressAction", "longPressAction", "flashlightHue", "flashlightSaturation", "flashlightBrightness", "automaticDuration"] },
            { "name": "automaticCount", "type": "u8", "minimum": 1, "maximum": 15 },
            { "name": "automaticEntries", "type": "array", "countFrom": "automaticCount", "element": [{ "name": "animationId", "type": "u8" }, { "name": "parameters", "type": "bytes", "length": 8 }] },
            { "name": "manualCount", "type": "u8", "minimum": 1, "maximum": 15 },
            { "name": "manualEntries", "type": "array", "countFrom": "manualCount", "element": [{ "name": "animationId", "type": "u8" }, { "name": "parameters", "type": "bytes", "length": 8 }] },
            { "name": "singleSlot", "type": "bytes", "length": 9, "layout": "animation ID followed by parameters 0..7" }
          ],
          "hash": { "algorithm": "sha256", "scope": "exactly the canonical bytes" },
          "rules": [
            "No padding, reserved capacity, optional field or trailing data.",
            "Validate the exact length from the counts and every value against the installed definition."
          ]
        },
        "revisionToken": {
          "bytes": 24,
          "fields": [
            { "name": "epoch", "type": "bytes", "length": 16, "note": "opaque, nonzero" },
            { "name": "counter", "type": "u64" }
          ],
          "rules": [
            "Compare the entire token for equality; within one epoch the counter orders confirmations.",
            "Different epochs require fresh readback, not arithmetic comparison."
          ]
        },
        "limits": {
          "maxLogicalMessageBytes": 512,
          "incompleteMessageIdleMs": 5000,
          "incompleteMessageTotalMs": 30000,
          "transactionIdleMs": 10000,
          "transactionTotalMs": 60000,
          "frozenReadMs": 30000,
          "replyWaitMs": 5000,
          "automaticRetry": { "maxRetries": 3, "delaysMs": [250, 500, 1000] },
          "foregroundAttemptMs": 30000,
          "automaticSaveMinIntervalMs": 500,
          "liveSamplesPerSecond": 10,
          "liveInputIdleMs": 400,
          "liveHeartbeatMs": 1000,
          "liveLeaseExpiryMs": 3000,
          "stopBeforeDisconnectMs": 2000,
          "terminalTransactionsRetained": 8,
          "pendingReplies": 4
        }
      }
    }
  ]
}
